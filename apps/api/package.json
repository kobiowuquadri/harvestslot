{
  "name": "@harvestslot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsc -b && concurrently -k -n tsc,run \"tsc -b --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "admin:create": "node dist/cli/create-admin.js",
    "openapi:export": "node dist/cli/export-openapi.js",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "seed": "node --enable-source-maps dist/cli/seed.js"
  },
  "dependencies": {
    "@harvestslot/config": "workspace:*",
    "@harvestslot/contracts": "workspace:*",
    "@harvestslot/core": "workspace:*",
    "@harvestslot/db": "workspace:*",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.3",
    "@node-rs/argon2": "2.2.2",
    "bullmq": "6.4.0",
    "cookie-parser": "1.4.7",
    "file-type": "22.2.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/supertest": "7.2.1",
    "embedded-postgres": "18.4.0-beta.17",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
