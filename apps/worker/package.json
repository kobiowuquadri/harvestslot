{
  "name": "@harvestslot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "dev": "tsc -b && concurrently -k -n tsc,run \"tsc -b --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "queue:migrate": "node dist/migrate-queue.js",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@harvestslot/config": "workspace:*",
    "@harvestslot/contracts": "workspace:*",
    "@harvestslot/core": "workspace:*",
    "@harvestslot/db": "workspace:*",
    "bullmq": "6.4.0",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "vitest": "5.0.5"
  }
}
