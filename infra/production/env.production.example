# Copy to infra/production/.env.production (never commit the copy) and replace every value.
# The API refuses to start in production with development defaults (packages/config/src/env.ts).

# ── Compose / proxy ──
HS_DOMAIN=harvestslot.example.org
ACME_EMAIL=ops@example.org
HS_VERSION=2026.10.1
POSTGRES_USER=harvestslot
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=harvestslot

# ── Application ──
NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info
PUBLIC_BASE_URL=https://harvestslot.example.org
ALLOWED_ORIGINS=https://harvestslot.example.org
API_INTERNAL_URL=http://api:4000
TRUST_PROXY=true
DATABASE_URL=postgresql://harvestslot:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/harvestslot
DATABASE_POOL_MAX=10
QUEUE_BACKEND=redis
REDIS_URL=redis://redis:6379

# openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_64_HEX_CHARS
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES
COOKIE_SECURE=true
ADMIN_REQUIRE_MFA=true

# ── Private object storage (S3-compatible; the bucket must not be public) ──
STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.REGION.provider.example
S3_REGION=REPLACE
S3_BUCKET=harvestslot-private
S3_ACCESS_KEY_ID=REPLACE
S3_SECRET_ACCESS_KEY=REPLACE
S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=10485760
# Optional virus scanning: run clamav/clamav:1.4 and set CLAMAV_HOST=clamav

# ── Email (required) and SMS (optional) ──
MAIL_TRANSPORT=smtp
SMTP_HOST=REPLACE
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE
SMTP_PASSWORD=REPLACE
MAIL_FROM=HarvestSlot <no-reply@harvestslot.example.org>
SMS_PROVIDER=none
# SMS_PROVIDER=termii
# TERMII_API_KEY=
# TERMII_SENDER_ID=

# ── Paystack (service-fee invoices only). Keep test keys until the account is verified. ──
PAYMENT_PROVIDER=paystack
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=REPLACE_WITH_sk_test_or_sk_live
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_pk_test_or_pk_live

# ── Maps / routing (optional) ──
MAP_STYLE_URL=
ROUTING_PROVIDER=none

# ── Never enable these in production ──
DEMO_MODE=false
DEV_TOOLS_ENABLED=false
AI_VOICE_DRAFTS_ENABLED=false
