# HarvestSlot environment — copy to .env and adjust. Never commit a real .env.
# Validation lives in packages/config/src/env.ts; the API and worker refuse to start on invalid values.

# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
# local | test | demo | staging | production. Demo features only in local/test/demo.
APP_ENV=local
LOG_LEVEL=info

# ── URLs ────────────────────────────────────────────────
# The single public origin. The web app proxies /api/* to the API in development.
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
API_PORT=4000
API_HOST=0.0.0.0
# Used by the Next.js server to reach the API (dev rewrites / server-side calls).
API_INTERNAL_URL=http://localhost:4000
# Set true behind a reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# ── Database / queues ──────────────────────────────────
DATABASE_URL=postgresql://harvestslot:harvestslot@localhost:5432/harvestslot
DATABASE_POOL_MAX=10
# redis (Docker/production) or postgres (BullMQ PostgreSQL backend, no Redis needed).
# Defaults to redis when REDIS_URL is set, otherwise postgres.
QUEUE_BACKEND=
REDIS_URL=redis://localhost:6379

# ── Sessions & secrets ─────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-development-session-secret-0123456789
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=Y2hhbmdlLW1lLWRldi1vbmx5LWtleS0zMmJ5dGVzISE=
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_ABSOLUTE_TIMEOUT_DAYS=14
COOKIE_SECURE=false
ADMIN_REQUIRE_MFA=false

# ── Object storage ─────────────────────────────────────
# s3 (MinIO locally / any S3-compatible service) or filesystem (development only)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=harvestslot-private
S3_ACCESS_KEY_ID=harvestslot
S3_SECRET_ACCESS_KEY=harvestslot-minio-dev
S3_FORCE_PATH_STYLE=true
FILESYSTEM_STORAGE_DIR=.local/storage
UPLOAD_MAX_BYTES=10485760
# Optional ClamAV daemon for malware scanning (docker compose --profile scan)
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Mail ───────────────────────────────────────────────
# smtp (Mailpit locally on 1025, UI on http://localhost:8025) or dev-capture (stored locally, development only)
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HarvestSlot <no-reply@harvestslot.example>
# true only when SMTP is a local capture tool (Mailpit). Demo accounts never receive external mail otherwise.
MAIL_LOCAL_CAPTURE=true

# ── SMS (optional) ─────────────────────────────────────
# none or termii. Without a provider SMS deliveries are recorded as UNAVAILABLE and phone OTP is disabled.
SMS_PROVIDER=none
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# ── Payments ───────────────────────────────────────────
# none | paystack | simulated (local only; refused in production). Paystack is used only for platform-fee invoices.
PAYMENT_PROVIDER=simulated
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_SIMULATOR_SECRET=change-me-simulator-secret

# ── Maps / routing ─────────────────────────────────────
# MapLibre style URL, e.g. https://tiles.openfreemap.org/styles/liberty (respect provider terms). Empty = list view only.
MAP_STYLE_URL=
MAP_ATTRIBUTION=
# none or osrm. Without routing, distances are straight-line and road estimates use ROAD_DISTANCE_FACTOR (labelled).
ROUTING_PROVIDER=none
OSRM_BASE_URL=
ROAD_DISTANCE_FACTOR=1.4

# ── Optional AI voice-to-draft (off by default) ───────
AI_VOICE_DRAFTS_ENABLED=false
# OpenAI-compatible /audio/transcriptions endpoint
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ── Demo & development safeguards ─────────────────────
# Demo logins/role switching. Refused when APP_ENV/NODE_ENV is production.
DEMO_MODE=true
# Local mail/OTP inspection pages. Refused in production.
DEV_TOOLS_ENABLED=true

# ── Business policy defaults (admins can override some in Policies) ──
OFFER_HOLD_HOURS=24
BOOKING_CONFIRMATION_HOLD_HOURS=72
TRANSPORT_BUFFER_MINUTES=120
HANDOVER_CODE_TTL_MINUTES=240
RECEIVING_REVIEW_HOURS=48
DISPUTE_RESPONSE_HOURS=72
PLATFORM_FEE_ENABLED=true
PLATFORM_FEE_BPS=150
IDEMPOTENCY_TTL_HOURS=48
