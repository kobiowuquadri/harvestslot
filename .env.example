# HarvestSlot environment. Copy to .env for local development; never commit a real .env.
# Hosted settings for Render are listed in render.yaml. Every other setting has a safe default.

# App
NODE_ENV=development
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000

# Database and background jobs
DATABASE_URL=postgresql://harvestslot:harvestslot@localhost:5432/harvestslot
QUEUE_BACKEND=postgres

# Security (generate new values: see docs/DEPLOYMENT.md)
SESSION_SECRET=change-me-development-session-secret-0123456789
DATA_ENCRYPTION_KEY=Y2hhbmdlLW1lLWRldi1vbmx5LWtleS0zMmJ5dGVzISE=
COOKIE_SECURE=false
ADMIN_REQUIRE_MFA=false

# File storage: filesystem for local work, cloudinary when CLOUDINARY_URL is set
STORAGE_DRIVER=filesystem
CLOUDINARY_URL=
CLOUDINARY_FOLDER=harvestslot

# Email: dev-capture keeps mail local; smtp sends through Brevo
MAIL_TRANSPORT=dev-capture
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HarvestSlot <no-reply@example.com>
MAIL_LOCAL_CAPTURE=false

# Payments for HarvestSlot fee invoices (farmers are paid by buyers directly)
PAYMENT_PROVIDER=simulated
PAYMENT_SIMULATOR_SECRET=change-me-simulator-secret

# Local-only helpers (refused in production)
DEMO_MODE=true
DEV_TOOLS_ENABLED=true
