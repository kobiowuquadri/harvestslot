// HarvestSlot database schema.
//
// Conventions
// - Table names are snake_case (@@map); columns are camelCase (quote them in raw SQL).
// - Quantities: NUMERIC(14,3) kilograms. Money: BIGINT kobo. Percentages: integer basis points.
// - Timestamps are UTC (timestamptz). Harvest dates are calendar dates in Africa/Lagos (DATE).
// - Mutable business records carry `version` for optimistic concurrency.
// - Contractual/financial history uses onDelete: Restrict; constraints and immutability triggers that
//   Prisma cannot express live in the SQL migration `*_constraints_and_triggers`.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

